# ============================================================
# ENVIRONMENT VARIABLES — Backend RentalMobil (MySQL)
# ============================================================

# Port server Express
PORT=5001

# ── MySQL Database ──────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rentalmobil

# ── JWT ─────────────────────────────────────────────────────
JWT_SECRET=rentalmobil_jwt_secret_key_2024_very_long_and_secure
JWT_EXPIRES_IN=7d

# ── CORS ────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Mode ────────────────────────────────────────────────────
NODE_ENV=development
